{
  "resource_type": "AWS::Serverless::Connector",
  "base_resources": [],
  "conditional_resources": [
    {
      "condition": "always",
      "resources": ["AWS::IAM::ManagedPolicy"]
    },
    {
      "condition": "properties.Source.Type == 'SNS' || properties.Destination.Type == 'SNS'",
      "resources": ["AWS::SNS::TopicPolicy"]
    },
    {
      "condition": "properties.Source.Type == 'SQS' || properties.Destination.Type == 'SQS'",
      "resources": ["AWS::SQS::QueuePolicy"]
    },
    {
      "condition": "properties.Source.Type == 'Lambda' || properties.Destination.Type == 'Lambda'",
      "resources": ["AWS::Lambda::Permission"]
    }
  ]
}
