{
  "resource_type": "AWS::Serverless::HttpApi",
  "base_resources": [
    "AWS::ApiGatewayV2::Api",
    "AWS::ApiGatewayV2::Stage"
  ],
  "conditional_resources": [
    {
      "condition": "properties.Domain.DomainName",
      "resources": ["AWS::ApiGatewayV2::DomainName"]
    },
    {
      "condition": "properties.AccessLogSettings",
      "resources": ["AWS::Logs::LogGroup"]
    }
  ]
}
